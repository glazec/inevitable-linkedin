{
  "manifest_version": 3,
  "name": "Inevitable Connections",
  "version": "0.2.2",
  "description": "Collect your LinkedIn connections, review duplicates, and import into Inevitable CRM.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://crm.inevitable.tech/*",
    "https://twenty-production-9617.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Inevitable Connections"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
